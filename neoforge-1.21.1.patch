diff --git a/src/main/java/destiny/penumbra_phantasm/compat/legacy/LegacyChannel.java b/src/main/java/destiny/penumbra_phantasm/compat/legacy/LegacyChannel.java
new file mode 100644
index 0000000..08b5080
--- /dev/null
+++ b/src/main/java/destiny/penumbra_phantasm/compat/legacy/LegacyChannel.java
@@ -0,0 +1,118 @@
+package destiny.penumbra_phantasm.compat.legacy;
+
+import destiny.penumbra_phantasm.PenumbraPhantasm;
+import net.minecraft.network.FriendlyByteBuf;
+import net.minecraft.network.RegistryFriendlyByteBuf;
+import net.minecraft.network.codec.StreamCodec;
+import net.minecraft.network.protocol.common.custom.CustomPacketPayload;
+import net.minecraft.resources.ResourceLocation;
+import net.neoforged.neoforge.network.event.RegisterPayloadHandlersEvent;
+import net.neoforged.neoforge.network.handling.IPayloadHandler;
+import net.neoforged.neoforge.network.registration.PayloadRegistrar;
+
+import java.util.LinkedHashMap;
+import java.util.Locale;
+import java.util.Map;
+import java.util.function.BiConsumer;
+import java.util.function.Function;
+import java.util.function.Supplier;
+
+/**
+ * Drop-in for the subset of Forge's SimpleChannel API this mod used
+ * (messageBuilder/encoder/decoder/consumerMainThread/add, send, sendToServer),
+ * implemented on NeoForge custom payloads. Register with
+ * {@code modEventBus.addListener(INSTANCE::registerPayloads)}.
+ */
+public class LegacyChannel {
+    public static final String PROTOCOL_VERSION = "1";
+
+    private record Entry<M>(Class<M> type,
+                            NetworkDirection direction,
+                            BiConsumer<M, FriendlyByteBuf> encoder,
+                            Function<FriendlyByteBuf, M> decoder,
+                            BiConsumer<M, Supplier<NetworkEvent.Context>> consumer,
+                            CustomPacketPayload.Type<LegacyPayload> payloadType) {
+    }
+
+    private final Map<Class<?>, Entry<?>> entries = new LinkedHashMap<>();
+
+    public <M> Builder<M> messageBuilder(Class<M> type, int id, NetworkDirection direction) {
+        return new Builder<>(type, direction);
+    }
+
+    public final class Builder<M> {
+        private final Class<M> type;
+        private final NetworkDirection direction;
+        private BiConsumer<M, FriendlyByteBuf> encoder;
+        private Function<FriendlyByteBuf, M> decoder;
+        private BiConsumer<M, Supplier<NetworkEvent.Context>> consumer;
+
+        private Builder(Class<M> type, NetworkDirection direction) {
+            this.type = type;
+            this.direction = direction;
+        }
+
+        public Builder<M> encoder(BiConsumer<M, FriendlyByteBuf> encoder) {
+            this.encoder = encoder;
+            return this;
+        }
+
+        public Builder<M> decoder(Function<FriendlyByteBuf, M> decoder) {
+            this.decoder = decoder;
+            return this;
+        }
+
+        public Builder<M> consumerMainThread(BiConsumer<M, Supplier<NetworkEvent.Context>> consumer) {
+            this.consumer = consumer;
+            return this;
+        }
+
+        public void add() {
+            CustomPacketPayload.Type<LegacyPayload> payloadType =
+                    new CustomPacketPayload.Type<>(ResourceLocation.fromNamespaceAndPath(PenumbraPhantasm.MODID, pathFor(type)));
+            entries.put(type, new Entry<>(type, direction, encoder, decoder, consumer, payloadType));
+        }
+    }
+
+    private static String pathFor(Class<?> type) {
+        String name = type.getName().substring(type.getPackageName().length() + 1).replace('$', '_');
+        return name.replaceAll("([a-z0-9])([A-Z])", "$1_$2").toLowerCase(Locale.ROOT);
+    }
+
+    public void registerPayloads(RegisterPayloadHandlersEvent event) {
+        PayloadRegistrar registrar = event.registrar(PROTOCOL_VERSION);
+        for (Entry<?> entry : entries.values()) {
+            register(registrar, entry);
+        }
+    }
+
+    @SuppressWarnings("unchecked")
+    private <M> void register(PayloadRegistrar registrar, Entry<M> entry) {
+        StreamCodec<RegistryFriendlyByteBuf, LegacyPayload> codec = StreamCodec.of(
+                (buf, payload) -> entry.encoder().accept((M) payload.message(), buf),
+                buf -> new LegacyPayload(entry.decoder().apply(buf), entry.payloadType()));
+        IPayloadHandler<LegacyPayload> handler = (payload, ctx) ->
+                entry.consumer().accept((M) payload.message(), () -> new NetworkEvent.Context(ctx));
+        if (entry.direction() == NetworkDirection.PLAY_TO_CLIENT) {
+            registrar.playToClient(entry.payloadType(), codec, handler);
+        } else {
+            registrar.playToServer(entry.payloadType(), codec, handler);
+        }
+    }
+
+    private LegacyPayload wrap(Object message) {
+        Entry<?> entry = entries.get(message.getClass());
+        if (entry == null) {
+            throw new IllegalArgumentException("Unregistered packet class " + message.getClass().getName());
+        }
+        return new LegacyPayload(message, entry.payloadType());
+    }
+
+    public void send(PacketDistributor.Target target, Object message) {
+        target.send(wrap(message));
+    }
+
+    public void sendToServer(Object message) {
+        net.neoforged.neoforge.network.PacketDistributor.sendToServer(wrap(message));
+    }
+}
