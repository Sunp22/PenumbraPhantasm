@@ -0,0 +1,21 @@
+package destiny.penumbra_phantasm.compat.legacy;
+
+import net.minecraft.core.BlockPos;
+import net.minecraft.nbt.CompoundTag;
+
+/** Keeps the old {X,Y,Z} compound layout that NbtUtils.writeBlockPos used before 1.21. */
+public final class PosNbt {
+    private PosNbt() {}
+
+    public static CompoundTag write(BlockPos pos) {
+        CompoundTag tag = new CompoundTag();
+        tag.putInt("X", pos.getX());
+        tag.putInt("Y", pos.getY());
+        tag.putInt("Z", pos.getZ());
+        return tag;
+    }
+
+    public static BlockPos read(CompoundTag tag) {
+        return new BlockPos(tag.getInt("X"), tag.getInt("Y"), tag.getInt("Z"));
+    }
+}
