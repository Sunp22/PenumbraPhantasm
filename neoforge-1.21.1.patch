+package destiny.penumbra_phantasm.compat;
+
+import net.minecraft.core.registries.Registries;
+import net.minecraft.resources.ResourceKey;
+import net.minecraft.server.MinecraftServer;
+import net.minecraft.server.level.ServerLevel;
+import net.minecraft.world.level.Level;
+import net.minecraft.world.level.dimension.LevelStem;
+
+import java.lang.reflect.Method;
+import java.util.function.Supplier;
+
+/**
+ * Reflection wrapper around Infiniverse so the mod compiles without it on the classpath.
+ * Infiniverse must be installed at runtime for dark worlds to be created.
+ */
+public final class InfiniverseCompat {
+    private InfiniverseCompat() {}
+
+    public static ServerLevel getOrCreateLevel(MinecraftServer server, ResourceKey<Level> key, Supplier<LevelStem> stem) {
+        try {
+            Class<?> apiClass = Class.forName("commoble.infiniverse.api.InfiniverseAPI");
+            Object api = apiClass.getMethod("get").invoke(null);
+            Method method = apiClass.getMethod("getOrCreateLevel", MinecraftServer.class, ResourceKey.class, Supplier.class);
+            return (ServerLevel) method.invoke(api, server, key, stem);
+        } catch (ReflectiveOperationException e) {
+            throw new IllegalStateException("Infiniverse is required to create dark worlds", e);
+        }
+    }
+}
