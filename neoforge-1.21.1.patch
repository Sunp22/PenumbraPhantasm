+import net.neoforged.neoforge.attachment.IAttachmentHolder;
+
+import java.util.function.Supplier;
+
+/** Replacement for Forge's Capability<T>: a thin handle onto a NeoForge data attachment. */
+public final class Capability<T> {
+    private final Supplier<? extends AttachmentType<T>> type;
+
+    public Capability(Supplier<? extends AttachmentType<T>> type) {
+        this.type = type;
+    }
+
+    public T get(IAttachmentHolder holder) {
+        return holder.getData(type.get());
+    }
+}
