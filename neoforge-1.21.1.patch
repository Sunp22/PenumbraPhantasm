+++ b/src/main/java/destiny/penumbra_phantasm/compat/legacy/ItemNbt.java
@@ -0,0 +1,79 @@
+package destiny.penumbra_phantasm.compat.legacy;
+
+import net.minecraft.core.component.DataComponents;
+import net.minecraft.nbt.CompoundTag;
+import net.minecraft.nbt.Tag;
+import net.minecraft.world.item.ItemStack;
+import net.minecraft.world.item.component.CustomData;
+import org.jetbrains.annotations.Nullable;
+
+import java.util.UUID;
+
+/**
+ * Shim for the removed ItemStack NBT tag API. Tags are stored in the CUSTOM_DATA component and a returned tag
+ * writes every change straight back to the stack, so old code like stack.getOrCreateTag().putInt(..) keeps working.
+ */
+public final class ItemNbt {
+    private ItemNbt() {}
+
+    public static boolean hasTag(ItemStack stack) {
+        return stack.has(DataComponents.CUSTOM_DATA);
+    }
+
+    @Nullable
+    public static CompoundTag getTag(ItemStack stack) {
+        CustomData data = stack.get(DataComponents.CUSTOM_DATA);
+        return data == null ? null : new StackTag(stack, data.copyTag());
+    }
+
+    public static CompoundTag getOrCreateTag(ItemStack stack) {
+        CustomData data = stack.get(DataComponents.CUSTOM_DATA);
+        return new StackTag(stack, data == null ? new CompoundTag() : data.copyTag());
+    }
+
+    public static void setTag(ItemStack stack, @Nullable CompoundTag tag) {
+        if (tag == null) {
+            stack.remove(DataComponents.CUSTOM_DATA);
+        } else {
+            stack.set(DataComponents.CUSTOM_DATA, CustomData.of(tag.copy()));
+        }
+    }
+
+    public static CompoundTag getOrCreateTagElement(ItemStack stack, String key) {
+        CompoundTag root = getOrCreateTag(stack);
+        if (!root.contains(key, Tag.TAG_COMPOUND)) {
+            root.put(key, new CompoundTag());
+        }
+        return root.getCompound(key);
+    }
+
+    private static final class StackTag extends CompoundTag {
+        private final ItemStack stack;
+
+        StackTag(ItemStack stack, CompoundTag source) {
+            super();
+            this.stack = stack;
+            for (String key : source.getAllKeys()) {
+                super.put(key, source.get(key));
+            }
+        }
+
+        private void sync() {
+            stack.set(DataComponents.CUSTOM_DATA, CustomData.of(this.copy()));
+        }
+
+        @Override public Tag put(String key, Tag value) { Tag old = super.put(key, value); sync(); return old; }
+        @Override public void putByte(String key, byte value) { super.putByte(key, value); sync(); }
+        @Override public void putShort(String key, short value) { super.putShort(key, value); sync(); }
+        @Override public void putInt(String key, int value) { super.putInt(key, value); sync(); }
+        @Override public void putLong(String key, long value) { super.putLong(key, value); sync(); }
+        @Override public void putUUID(String key, UUID value) { super.putUUID(key, value); sync(); }
+        @Override public void putFloat(String key, float value) { super.putFloat(key, value); sync(); }
+        @Override public void putDouble(String key, double value) { super.putDouble(key, value); sync(); }
+        @Override public void putString(String key, String value) { super.putString(key, value); sync(); }
+        @Override public void putByteArray(String key, byte[] value) { super.putByteArray(key, value); sync(); }
+        @Override public void putIntArray(String key, int[] value) { super.putIntArray(key, value); sync(); }
+        @Override public void putBoolean(String key, boolean value) { super.putBoolean(key, value); sync(); }
+        @Override public void remove(String key) { super.remove(key); sync(); }
+    }
+}
diff --git a/src/main/java/destiny/penumbra_phantasm/compat/legacy/LazyOptional.java b/src/main/java/destiny/penumbra_phantasm/compat/legacy/LazyOptional.java
new file mode 100644
index 0000000000000000000000000000000000000000..4a562292cd6a06ba9c0d34ac4b95090c0308419b
--- /dev/null
+++ b/src/main/java/destiny/penumbra_phantasm/compat/legacy/LazyOptional.java
@@ -0,0 +1,88 @@
+package destiny.penumbra_phantasm.compat.legacy;
+
+import java.util.Optional;
+import java.util.function.Consumer;
+import java.util.function.Function;
+import java.util.function.Predicate;
+import java.util.function.Supplier;
+
+/** Tiny stand-in for Forge's LazyOptional (removed in NeoForge 1.21). */
+public final class LazyOptional<T> {
+    private static final LazyOptional<?> EMPTY = new LazyOptional<>(null);
+
+    private final Supplier<T> supplier;
+
+    private LazyOptional(Supplier<T> supplier) {
+        this.supplier = supplier;
+    }
+
+    public static <T> LazyOptional<T> of(Supplier<T> supplier) {
+        return new LazyOptional<>(supplier);
+    }
+
+    @SuppressWarnings("unchecked")
+    public static <T> LazyOptional<T> empty() {
+        return (LazyOptional<T>) EMPTY;
+    }
+
+    private T value() {
+        return supplier == null ? null : supplier.get();
+    }
+
+    public boolean isPresent() {
+        return value() != null;
+    }
+
+    public void ifPresent(Consumer<? super T> consumer) {
+        T v = value();
+        if (v != null) consumer.accept(v);
+    }
+
+    public T orElse(T other) {
+        T v = value();
+        return v != null ? v : other;
+    }
+
+    public T orElseGet(Supplier<? extends T> other) {
+        T v = value();
+        return v != null ? v : other.get();
+    }
+
+    public <X extends Throwable> T orElseThrow(Supplier<? extends X> exception) throws X {
+        T v = value();
+        if (v == null) throw exception.get();
+        return v;
+    }
+
+    public Optional<T> resolve() {
+        return Optional.ofNullable(value());
+    }
+
+    public <U> LazyOptional<U> map(Function<? super T, ? extends U> mapper) {
+        if (supplier == null) return empty();
+        return new LazyOptional<>(() -> {
+            T v = value();
+            return v == null ? null : mapper.apply(v);
+        });
+    }
+
+    public LazyOptional<T> filter(Predicate<? super T> predicate) {
+        if (supplier == null) return this;
+        return new LazyOptional<>(() -> {
+            T v = value();
+            return v != null && predicate.test(v) ? v : null;
+        });
+    }
+
+    @SuppressWarnings("unchecked")
+    public <X> LazyOptional<X> cast() {
+        return (LazyOptional<X>) this;
+    }
+
+    public void invalidate() {
+    }
+
+    public LazyOptional<T> addListener(Consumer<LazyOptional<T>> listener) {
+        return this;
+    }
+}
