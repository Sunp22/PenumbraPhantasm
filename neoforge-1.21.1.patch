+
+/** Entry point replacing {@code holder.getCapability(CAP)} with attachment lookups. */
+public final class LegacyCaps {
+    private LegacyCaps() {}
+
+    public static <T> LazyOptional<T> get(Object holder, Capability<T> capability) {
