+package destiny.penumbra_phantasm.client.render.screen.component;
+
+import com.mojang.blaze3d.systems.RenderSystem;
+import net.minecraft.client.gui.GuiGraphics;
+import net.minecraft.client.gui.components.StateSwitchingButton;
+import net.minecraft.resources.ResourceLocation;
+
+/**
+ * Texture-sheet based replacement for the pre-1.20.2 StateSwitchingButton behaviour
+ * (1.21 vanilla switched to WidgetSprites; this mod's recipe book still uses a UV sheet).
+ */
+public class DarkWorldStateButton extends StateSwitchingButton {
+    protected ResourceLocation resourceLocation;
+    protected int xTexStart;
+    protected int yTexStart;
+    protected int xDiffTex;
+    protected int yDiffTex;
+
+    public DarkWorldStateButton(int x, int y, int w, int h, boolean triggered) {
+        super(x, y, w, h, triggered);
+    }
+
+    public void initTextureValues(int xTexStart, int yTexStart, int xDiffTex, int yDiffTex, ResourceLocation location) {
+        this.xTexStart = xTexStart;
+        this.yTexStart = yTexStart;
+        this.xDiffTex = xDiffTex;
+        this.yDiffTex = yDiffTex;
+        this.resourceLocation = location;
+    }
+
+    @Override
+    public void renderWidget(GuiGraphics graphics, int mouseX, int mouseY, float partialTick) {
+        if (this.resourceLocation == null) {
+            return;
+        }
+        RenderSystem.disableDepthTest();
+        int u = this.xTexStart;
+        int v = this.yTexStart;
+        if (this.isStateTriggered) {
+            u += this.xDiffTex;
+        }
+        if (this.isHoveredOrFocused()) {
+            v += this.yDiffTex;
+        }
+        graphics.blit(this.resourceLocation, this.getX(), this.getY(), u, v, this.width, this.height);
+        RenderSystem.enableDepthTest();
+    }
+}
