diff --git a/src/main/java/destiny/penumbra_phantasm/server/util/NineSlice.java b/src/main/java/destiny/penumbra_phantasm/server/util/NineSlice.java
new file mode 100644
index 0000000..9261dbf
--- /dev/null
+++ b/src/main/java/destiny/penumbra_phantasm/server/util/NineSlice.java
@@ -0,0 +1,41 @@
+package destiny.penumbra_phantasm.server.util;
+
+import net.minecraft.client.gui.GuiGraphics;
+import net.minecraft.resources.ResourceLocation;
+
+/** Replacement for GuiGraphics#blitNineSliced, which no longer exists in 1.21.1. Assumes a 256x256 texture sheet. */
+public final class NineSlice {
+    private NineSlice() {}
+
+    public static void blit(GuiGraphics g, ResourceLocation tex, int x, int y, int w, int h,
+                            int cornerW, int cornerH, int regionW, int regionH, int u, int v) {
+        cornerW = Math.min(cornerW, w / 2);
+        cornerH = Math.min(cornerH, h / 2);
+        int midW = w - cornerW * 2, midH = h - cornerH * 2;
+        int srcMidW = regionW - cornerW * 2, srcMidH = regionH - cornerH * 2;
+        int xr = x + w - cornerW, yb = y + h - cornerH;
+        int ur = u + regionW - cornerW, vb = v + regionH - cornerH;
+        // corners
+        part(g, tex, x, y, cornerW, cornerH, u, v, cornerW, cornerH);
+        part(g, tex, xr, y, cornerW, cornerH, ur, v, cornerW, cornerH);
+        part(g, tex, x, yb, cornerW, cornerH, u, vb, cornerW, cornerH);
+        part(g, tex, xr, yb, cornerW, cornerH, ur, vb, cornerW, cornerH);
+        // edges
+        part(g, tex, x + cornerW, y, midW, cornerH, u + cornerW, v, srcMidW, cornerH);
+        part(g, tex, x + cornerW, yb, midW, cornerH, u + cornerW, vb, srcMidW, cornerH);
+        part(g, tex, x, y + cornerH, cornerW, midH, u, v + cornerH, cornerW, srcMidH);
+        part(g, tex, xr, y + cornerH, cornerW, midH, ur, v + cornerH, cornerW, srcMidH);
+        // centre
+        part(g, tex, x + cornerW, y + cornerH, midW, midH, u + cornerW, v + cornerH, srcMidW, srcMidH);
+    }
+
+    public static void blit(GuiGraphics g, ResourceLocation tex, int x, int y, int w, int h,
+                            int corner, int regionW, int regionH, int u, int v) {
+        blit(g, tex, x, y, w, h, corner, corner, regionW, regionH, u, v);
+    }
+
+    private static void part(GuiGraphics g, ResourceLocation tex, int x, int y, int w, int h, int u, int v, int uw, int vh) {
+        if (w <= 0 || h <= 0 || uw <= 0 || vh <= 0) return;
+        g.blit(tex, x, y, w, h, (float) u, (float) v, uw, vh, 256, 256);
+    }
+}
