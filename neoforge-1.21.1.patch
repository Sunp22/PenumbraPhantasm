+package destiny.penumbra_phantasm.compat.legacy;
+
+import net.minecraft.server.level.ServerPlayer;
+import net.neoforged.neoforge.network.handling.IPayloadContext;
+
+import java.util.concurrent.CompletableFuture;
+
+/** Minimal replacement for Forge's NetworkEvent so existing packet classes keep their handle(Supplier<Context>) shape. */
+public class NetworkEvent {
+    public static class Context {
+        private final IPayloadContext ctx;
+
+        Context(IPayloadContext ctx) {
+            this.ctx = ctx;
+        }
+
+        public CompletableFuture<Void> enqueueWork(Runnable runnable) {
+            return ctx.enqueueWork(runnable);
+        }
+
+        /** The sending player when this packet is server-bound, otherwise null. */
+        public ServerPlayer getSender() {
+            return ctx.player() instanceof ServerPlayer sp ? sp : null;
+        }
+
+        public NetworkDirection getDirection() {
+            return ctx.flow().isClientbound() ? NetworkDirection.PLAY_TO_CLIENT : NetworkDirection.PLAY_TO_SERVER;
+        }
+
+        public void setPacketHandled(boolean handled) {
+            // NeoForge payload handlers do not need this flag.
+        }
+
+        public boolean getPacketHandled() {
+            return true;
+        }
+    }
+}
diff --git a/src/main/java/destiny/penumbra_phantasm/compat/legacy/PacketDistributor.java b/src/main/java/destiny/penumbra_phantasm/compat/legacy/PacketDistributor.java
new file mode 100644
index 0000000000000000000000000000000000000000..6c316830e49536dea730ed5a0a583942e556597d
--- /dev/null
+++ b/src/main/java/destiny/penumbra_phantasm/compat/legacy/PacketDistributor.java
@@ -0,0 +1,85 @@
+package destiny.penumbra_phantasm.compat.legacy;
+
+import net.minecraft.network.protocol.common.custom.CustomPacketPayload;
+import net.minecraft.resources.ResourceKey;
+import net.minecraft.server.MinecraftServer;
+import net.minecraft.server.level.ServerLevel;
+import net.minecraft.server.level.ServerPlayer;
+import net.minecraft.world.entity.Entity;
+import net.minecraft.world.level.Level;
+import net.minecraft.world.level.chunk.LevelChunk;
+import net.neoforged.neoforge.server.ServerLifecycleHooks;
+
+import java.util.function.BiConsumer;
+import java.util.function.Supplier;
+
+/** Forge-style PacketDistributor facade over {@link net.neoforged.neoforge.network.PacketDistributor}. */
+public final class PacketDistributor {
+    private PacketDistributor() {}
+
+    public interface Target {
+        void send(CustomPacketPayload payload);
+    }
+
+    public static final class Distributor<T> {
+        private final BiConsumer<T, CustomPacketPayload> sender;
+
+        private Distributor(BiConsumer<T, CustomPacketPayload> sender) {
+            this.sender = sender;
+        }
+
+        public Target with(Supplier<T> supplier) {
+            return payload -> sender.accept(supplier.get(), payload);
+        }
+    }
+
+    public static final class TargetPoint {
+        public final ServerPlayer excluded;
+        public final double x, y, z, radius;
+        public final ResourceKey<Level> dimension;
+
+        public TargetPoint(double x, double y, double z, double radius, ResourceKey<Level> dimension) {
+            this(null, x, y, z, radius, dimension);
+        }
+
+        public TargetPoint(ServerPlayer excluded, double x, double y, double z, double radius, ResourceKey<Level> dimension) {
+            this.excluded = excluded;
+            this.x = x;
+            this.y = y;
+            this.z = z;
+            this.radius = radius;
+            this.dimension = dimension;
+        }
+    }
+
+    private static ServerLevel level(ResourceKey<Level> key) {
+        MinecraftServer server = ServerLifecycleHooks.getCurrentServer();
