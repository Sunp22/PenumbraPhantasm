@@ -0,0 +1,33 @@
+package destiny.penumbra_phantasm.client.render;
+
+import destiny.penumbra_phantasm.server.util.ModUtil;
+import net.minecraft.client.model.HumanoidModel;
+import net.minecraft.util.Mth;
+import net.minecraft.world.entity.HumanoidArm;
+import net.neoforged.neoforge.client.IArmPoseTransformer;
+import net.neoforged.fml.common.asm.enumextension.EnumProxy;
+
+/**
+ * Custom arm pose registered through NeoForge's enum extension system
+ * (see META-INF/enumextensions.json and the enumExtensions key in neoforge.mods.toml).
+ */
+public final class SoulHearthArmPose {
+    public static final IArmPoseTransformer TRANSFORMER = (model, entity, arm) -> {
+        if (arm == HumanoidArm.RIGHT) {
+            model.rightArm.xRot = 4.8f + entity.getXRot() / 90;
+            model.rightArm.yRot = Mth.clamp(ModUtil.wrapRad(0 + model.head.yRot), -0.5f, 1);
+        } else {
+            model.leftArm.xRot = 4.8f + entity.getXRot() / 90;
+            model.leftArm.yRot = Mth.clamp(ModUtil.wrapRad(0 + model.head.yRot), -0.5f, 1);
+        }
+    };
+
+    public static final EnumProxy<HumanoidModel.ArmPose> PROXY =
+            new EnumProxy<>(HumanoidModel.ArmPose.class, false, TRANSFORMER);
+
+    private SoulHearthArmPose() {}
+
+    public static HumanoidModel.ArmPose get() {
+        return PROXY.getValue();
